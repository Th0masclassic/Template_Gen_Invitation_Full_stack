# Core server
OPENAI_API_KEY=sk-your-openai-key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_ENVELOPE_IMAGE_MODEL=gpt-image-2
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000
MAX_CONCURRENT_GENERATIONS=2
MAX_GENERATION_QUEUE=10
MAX_CONCURRENT_OPENAI_IMAGE_REQUESTS=2
OPENAI_WEBSITE_COPY_MODEL=gpt-5.6-luna
OPENAI_WEBSITE_COPY_TIMEOUT_MS=45000

# Customer access
ACCESS_CODE_REQUIRED=1
ACCESS_CODE_STORE_PATH=generated/access-codes.json
ACCESS_CODE_SESSION_SECRET=replace-with-a-long-random-secret
ACCESS_CODE_SESSION_MAX_AGE_SECONDS=15552000
# Local website preview only. Production requests still require the project code.
RSVP_ADMIN_LOCAL_BYPASS=1

# Private web administration. Run `npm run admin:password` and enter the new
# password at the masked prompt, then paste only the generated hash below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$131072$8$1$replace-with-generated-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_COOKIE_NAME=invitelab_admin
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800

# Signs permanent Etsy-PDF entry links such as
# /tempOnly/07_aquarela.png/gen?grant=... . Keep it different from the admin
# and customer session secrets.
TEMPLATE_LINK_SECRET=replace-with-another-at-least-32-character-random-secret
TEMPLATE_LINK_COOKIE_NAME=invitelab_template

# Etsy order fulfillment
ETSY_INTEGRATION_ENABLED=0
ETSY_SHOP_ID=12345678
ETSY_API_KEYSTRING=your-etsy-api-keystring
ETSY_API_SHARED_SECRET=your-etsy-api-shared-secret
ETSY_WEBHOOK_SIGNING_SECRET=whsec_your-base64-signing-secret
ETSY_OAUTH_ACCESS_TOKEN=
ETSY_OAUTH_REFRESH_TOKEN=your-etsy-refresh-token
ETSY_OAUTH_EXPIRES_AT=
ETSY_LISTING_PACK_MAP={"1234567890":{"packType":"invite_only_pack","creationMode":"template","eventType":"wedding","templateId":"aquarela_paris"},"2345678901":{"packType":"digital_pdf_pack","creationMode":"template"},"3456789012":{"packType":"Full_pack","creationMode":"both"}}
ETSY_API_TIMEOUT_MS=15000
ETSY_WEBHOOK_TOLERANCE_SECONDS=300

# Stripe Checkout (one-time Prices). ACCESS_CODE_REQUIRED must stay enabled:
# paid website buyers receive a signed browser session automatically, while the
# emailed six-digit code remains a fallback for another browser/device.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_TEMPLATE_ONLY=price_your-template-only-price
STRIPE_PRICE_DIGITAL_INVITE=price_your-digital-invite-price
STRIPE_PRICE_FULL_PACK=price_your-full-pack-price
STRIPE_API_TIMEOUT_MS=15000
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Purchase email (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=InviteLab <orders@invitelab.art>
RESEND_REPLY_TO_EMAIL=support@invitelab.art
CUSTOMER_SUPPORT_EMAIL=support@invitelab.art
CUSTOMER_PORTAL_URL=https://invitelab.art
AUTOMATION_ALERT_EMAIL=tomascoelhorocha@gmail.com
ETSY_REVIEW_URL=https://www.etsy.com/your/purchases

# RSVP / Youform
# Every Full Pack includes a native RSVP form and a code-protected RSVP Admin.
# The same normalized email is stored only once per project. No Youform key is
# required. To accept submissions from an additional manually-created Youform,
# set its URL and the same webhook signing secret configured in Youform.
YOUFORM_DEFAULT_FORM_URL=
YOUFORM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Canva operator integration
CANVA_IMPORT_ENABLED=true
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/auth/callback
CANVA_SCOPES=design:content:read design:content:write design:meta:read asset:read asset:write brandtemplate:content:read brandtemplate:meta:read
CANVA_OPERATOR_AUTH_AT_STARTUP=true

# Shared website hosting (Cloudflare R2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=invitelab-invites-sites
R2_PUBLIC_BASE_URL=https://invites.invitelab.art
MAX_CONCURRENT_SITE_PUBLISHES=2
SITE_PUBLISH_MAX_ATTEMPTS=3
SITE_PUBLISH_RETRY_DELAY_MS=5000

# Optional legacy EdgeOne deployment
EDGEONE_API_TOKEN=
EDGEONE_CLI_PATH=
EDGEONE_PROJECT_PREFIX=invitelab
EDGEONE_DEPLOY_AREA=global
EDGEONE_DEPLOY_ENV=production
