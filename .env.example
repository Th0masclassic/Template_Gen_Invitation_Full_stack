# Core server
OPENAI_API_KEY=sk-your-openai-key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_ENVELOPE_IMAGE_MODEL=gpt-image-2
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000
MAX_CONCURRENT_GENERATIONS=3
MAX_GENERATION_QUEUE=30
OPENAI_WEBSITE_COPY_MODEL=gpt-5.6-luna
OPENAI_WEBSITE_COPY_TIMEOUT_MS=45000

# Customer access
ACCESS_CODE_REQUIRED=1
ACCESS_CODE_STORE_PATH=generated/access-codes.json
ACCESS_CODE_SESSION_SECRET=replace-with-a-long-random-secret
ACCESS_CODE_SESSION_MAX_AGE_SECONDS=15552000

# Etsy order fulfillment
ETSY_INTEGRATION_ENABLED=0
ETSY_SHOP_ID=12345678
ETSY_API_KEYSTRING=your-etsy-api-keystring
ETSY_API_SHARED_SECRET=your-etsy-api-shared-secret
ETSY_WEBHOOK_SIGNING_SECRET=whsec_your-base64-signing-secret
ETSY_OAUTH_ACCESS_TOKEN=
ETSY_OAUTH_REFRESH_TOKEN=your-etsy-refresh-token
ETSY_OAUTH_EXPIRES_AT=
ETSY_LISTING_PACK_MAP={"1234567890":{"packType":"invite_only_pack","creationMode":"template"},"2345678901":{"packType":"digital_pdf_pack","creationMode":"both"},"3456789012":{"packType":"Full_pack","creationMode":"both"}}
ETSY_API_TIMEOUT_MS=15000
ETSY_WEBHOOK_TOLERANCE_SECONDS=300

# Purchase email (Resend)
RESEND_API_KEY=re_QiJdWwhc_3SoMYSWbs9Gho8xYs2rgVSfW
RESEND_FROM_EMAIL=InviteLab <orders@invitelab.art>
RESEND_REPLY_TO_EMAIL=support@invitelab.art
CUSTOMER_SUPPORT_EMAIL=support@invitelab.art
CUSTOMER_PORTAL_URL=https://invitelab.art
AUTOMATION_ALERT_EMAIL=tomascoelhorocha@gmail.com
ETSY_REVIEW_URL=https://www.etsy.com/your/purchases

# RSVP / Youform
# Every Full Pack includes a native RSVP form and a code-protected RSVP Admin.
# The same normalized email is stored only once per project. No Youform key is
# required. To accept submissions from an additional manually-created Youform,
# set its URL and the same webhook signing secret configured in Youform.
YOUFORM_DEFAULT_FORM_URL=
YOUFORM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Canva operator integration
CANVA_IMPORT_ENABLED=true
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/oauth/callback
CANVA_SCOPES=design:content:read design:content:write design:meta:read asset:read asset:write brandtemplate:content:read brandtemplate:meta:read
CANVA_OPERATOR_AUTH_AT_STARTUP=true

# Shared website hosting (Cloudflare R2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=invitelab-invites-sites
R2_PUBLIC_BASE_URL=https://invites.invitelab.art
MAX_CONCURRENT_SITE_PUBLISHES=2
SITE_PUBLISH_MAX_ATTEMPTS=3
SITE_PUBLISH_RETRY_DELAY_MS=5000

# Optional legacy EdgeOne deployment
EDGEONE_API_TOKEN=
EDGEONE_CLI_PATH=
EDGEONE_PROJECT_PREFIX=invitelab
EDGEONE_DEPLOY_AREA=global
EDGEONE_DEPLOY_ENV=production
